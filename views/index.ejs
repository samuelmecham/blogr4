<div class="author">
    <h1 class="author__heading">Hello, i'm Developer.</h1>
    <p class="author__body">Web Developer and Student</p>
</div>

<img src="img/apple.jpeg" alt="apple" />

<section class="articles">
    <h2 class="articles__heading">Latest Posts</h2>

    <!-- Dummy data displayed until we include posts later on left at 4:02 -->
     <ul class="article-url">

        <% data.forEach(post => { %>
            <Li>
                <a href="/post/<%= post._id  %>">
                    <span><%- post.title  %></span>
                    <span class="article-list__date">
                    <% post.createdAt.toDateString() %>
                    </span>
                </a>
            </Li>
        <% }); %>
     </ul>

     <a href="#" class="pagination" &lt; View Older Posts>
        
     </a>
</section>